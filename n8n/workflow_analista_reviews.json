      "parameters": {
        "jsCode": "// Percorre cada item retornado pelo agente\nreturn $input.all().map(item => {\n  try {\n    // Faz o parse do JSON contido na string output\n    const parsedData = JSON.parse(item.json.output);\n\n    return {\n      json: {\n        order_id: parsedData.order_id,\n        review_id: parsedData.review_id,\n        categoria: parsedData.categoria,\n        origem: parsedData.origem,\n        divergencia: parsedData.divergencia,\n        destino: parsedData.destino,\n        severidade: parsedData.severidade,\n        confianca: Number(parsedData.confianca), // Garante que seja um número (Float)\n        resumo: parsedData.resumo\n      }\n    };\n  } catch (error) {\n    // Trata eventuais erros de parse caso a IA não retorne um JSON válido\n    return {\n      json: {\n        raw_output: item.json.output,\n        confianca: 0,\n        erro_parse: true\n      }\n    };\n  }\n});"
      },
