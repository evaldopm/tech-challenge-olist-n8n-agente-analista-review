    {
      "parameters": {
        "jsCode": "function parseDate(value) {\n  if (!value) return null;\n\n  const date = new Date(String(value).replace(' ', 'T'));\n  return Number.isNaN(date.getTime()) ? null : date;\n}\n\nreturn $input.all().map((item) => {\n  const data = item.json;\n\n  const dataEntrega = parseDate(data.order_delivered_customer_date);\n  const dataEstimada = parseDate(data.order_estimated_delivery_date);\n  const dataRespostaReview = parseDate(data.review_answer_timestamp);\n\n  const pedidoEntregueComAtraso =\n    dataEntrega &&\n    dataEstimada &&\n    dataEntrega > dataEstimada;\n\n  const pedidoNaoEntregueAposPrazo =\n    !dataEntrega &&\n    dataEstimada &&\n    dataRespostaReview &&\n    dataRespostaReview > dataEstimada;\n\n  const houveAtraso =\n    pedidoEntregueComAtraso || pedidoNaoEntregueAposPrazo;\n\n  let diasAtraso = 0;\n\n  if (pedidoEntregueComAtraso) {\n    diasAtraso = Math.ceil(\n      (dataEntrega.getTime() - dataEstimada.getTime()) /\n        (1000 * 60 * 60 * 24)\n    );\n  } else if (pedidoNaoEntregueAposPrazo) {\n    diasAtraso = Math.ceil(\n      (dataRespostaReview.getTime() - dataEstimada.getTime()) /\n        (1000 * 60 * 60 * 24)\n    );\n  }\n\n  if (houveAtraso) {\n    return {\n      json: {\n        order_id: data.order_id,\n        review_id: data.review_id,\n        categoria: 'Atraso',\n        origem: 'Dados operacionais',\n        destino: 'Logística',\n        severidade: 'Alta',\n        resumo: pedidoEntregueComAtraso\n          ? `Pedido entregue ${diasAtraso} dia(s) após o prazo estimado.`\n          : `Pedido ainda não entregue ${diasAtraso} dia(s) após o prazo estimado.`,\n      }\n    };\n  }\n\n  return {\n    json: {\n      order_id: data.order_id,\n      review_id: data.review_id,\n      categoria: 'Outro',\n      origem: 'Dados operacionais',\n      destino: 'Revisão humana',\n      severidade: 'Baixa',\n      resumo: 'Avaliação baixa sem comentário e sem evidência de atraso.',\n    }\n  };\n});"
      },
